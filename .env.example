# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM -------------------------------------------------------------------
# Provider-swappable model id passed straight to langchain's init_chat_model.
# The thesis evaluation uses "google_genai:gemini-3.6-flash" (needs GOOGLE_API_KEY).
# Other examples: "anthropic:claude-opus-5-5" (ANTHROPIC_API_KEY),
# "groq:openai/gpt-oss-120b" (hosted on Groq, needs GROQ_API_KEY),
# "mistralai:mistral-large-latest" (MISTRAL_API_KEY),
# "ollama:qwen3:4b-instruct-2507-q4_K_M" (local, no key; needs a running Ollama).
# Each provider needs a model.init_kwargs.<provider> block in configs/agent.yaml.
PP_MODEL=google_genai:gemini-3.6-flash

# Only the provider matching PP_MODEL needs a key. Everything else runs offline.
GOOGLE_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# GROQ_API_KEY=gsk_REPLACE_ME
# MISTRAL_API_KEY=REPLACE_ME

# --- evaluation data -------------------------------------------------------
# Absolute path to the BPI Challenge 2019 XES log. Machine specific: the raw
# file stays outside the repository, configs reference it through this var.
PP_BPI2019_PATH=C:\path\to\BPI_Challenge_2019.xes

# --- app (optional) --------------------------------------------------------
# Where the web app's dev server (npm run dev in web/) forwards API calls
# (default: http://127.0.0.1:8000). Not needed for the built app.
# PP_API_URL=http://127.0.0.1:8000
# Where mining runs and the API's own state (SQLite index, uploads) go.
# Defaults: outputs/runs and outputs/app.
# PP_RUNS_DIR=C:\path\to\runs
# PP_APP_DIR=C:\path\to\app-state
