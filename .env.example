# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM -------------------------------------------------------------------
# Provider-swappable model id passed straight to langchain's init_chat_model.
# Examples: "anthropic:claude-opus-5-5", "anthropic:claude-sonnet-5-5",
# "ollama:qwen3:4b-instruct-2507-q4_K_M" (local, no key; needs a running Ollama).
# Each provider needs a model.init_kwargs.<provider> block in configs/agent.yaml.
PP_MODEL=anthropic:claude-opus-5-5

# Only the provider matching PP_MODEL needs a key. Everything else runs offline.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME

# --- evaluation data -------------------------------------------------------
# Absolute path to the BPI Challenge 2019 XES log. Machine specific: the raw
# file stays outside the repository, configs reference it through this var.
PP_BPI2019_PATH=C:\path\to\BPI_Challenge_2019.xes

# Optional: second dataset for the Phase 5 generalizability notebook.
# PP_SECOND_DATASET_PATH=C:\path\to\other_log.xes
